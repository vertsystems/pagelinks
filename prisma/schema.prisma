// PageLinks — schema portátil
//
// Roda em SQLite no desenvolvimento e migra para PostgreSQL (Supabase) sem
// reescrita: nada de Json, enum nativo ou array — só tipos que os dois suportam.
// Campo que seria enum é String com os valores documentados ao lado.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// A URL fica em prisma.config.ts (CLI) e no adapter em lib/prisma.ts (runtime).
// Trocar para PostgreSQL depois é mudar só o provider aqui e o adapter lá.
datasource db {
  provider = "postgresql"
}

/// Quem contrata a página. Um cliente pode ter mais de uma página (campanha, filial).
model Cliente {
  id        String   @id @default(cuid())
  nome      String
  slug      String   @unique // vira o endereço: dnms.fun/<slug>
  dominio   String?  @unique // domínio próprio, quando houver
  ativo     Boolean  @default(true)
  observacao String?
  conferido Boolean  @default(false) // marcação do painel: página revisada (verde) ou faltando algo (amarelo)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  paginas  Pagina[]
  usuarios Usuario[]

  @@index([ativo])
}

/// A página de links em si: conteúdo, tema e SEO.
model Pagina {
  id        String  @id @default(cuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  titulo    String
  bio       String?
  semTitulo Boolean @default(false) // título e frase fora da página (fica só a foto ou logo); o título segue valendo para o Google e a aba
  avatarUrl String?
  avatarTamanho Int? // diâmetro em px; vazio = 104 (no formato "livre", é a largura)
  avatarFormato String? // vazio = redonda · "livre" = o logo inteiro, sem cortar nem borda
  // tamanho real dos arquivos, em px: vira width/height no <img>, e o navegador guarda o
  // lugar da imagem antes de ela chegar (sem isso a página pulava, o CLS). Vazio = sem medida
  avatarLargura    Int?
  avatarAltura     Int?
  // arte da marca que já traz o nome e a frase: quando existe, substitui título e bio na página
  cabecalhoImagemUrl String?
  cabecalhoTamanho   Int? // largura em % da coluna; vazio = 100
  cabecalhoLargura   Int? // tamanho real do arquivo, como avatarLargura
  cabecalhoAltura    Int?
  tituloTamanho Int? // tamanho da letra do título em px; vazio = 24 no celular, 28 no tablet e no computador
  bioTamanho    Int? // tamanho da letra da frase em px; vazio = 16
  publicada Boolean @default(false)

  // tema — o que o painel edita sem tocar em código
  corFundo      String @default("#101010")
  corTexto      String @default("#F2F2F2")
  corDestaque   String @default("#FF6F00")
  corTextoBotao String @default("#101010")
  fonte         String @default("Inter")
  estiloBotao   String @default("arredondado") // arredondado | reto | pilula | contorno
  fundoTipo     String @default("solido")      // solido | gradiente | imagem
  fundoImagemUrl String?
  fundoCorFim   String? // segunda cor, quando fundoTipo = gradiente

  // espaços, em px (barras do painel); vazio = padrão
  espacoTopo   Int? // acima do primeiro elemento da página; vazio = 36 no celular, 48 no computador
  espacoBlocos Int? // entre um bloco e outro; vazio = 14
  espacoLado   Int? // entre blocos lado a lado; vazio = igual ao espacoBlocos

  // Layout por tela (lib/ajustes.ts). As colunas de tamanho e espaço acima são as do
  // celular; tablet e computador guardam só o que mudou, em JSON ({"topo": 80, ...}).
  // O que falta segue a tela menor.
  ajustesTablet     String?
  ajustesComputador String?

  // SEO e compartilhamento
  seoTitulo    String?
  seoDescricao String?
  seoImagemUrl String?
  faviconUrl   String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  cards Card[]

  @@index([clienteId])
  @@index([publicada])
}

/// Bloco da página. O `tipo` é o que dá o efeito Elementor:
/// cada tipo usa os campos que precisa e ignora o resto.
///
/// tipos: link | destaque | texto | titulo | imagem | video | whatsapp | redes | mapa | separador
model Card {
  id       String @id @default(cuid())
  paginaId String
  pagina   Pagina @relation(fields: [paginaId], references: [id], onDelete: Cascade)

  tipo      String
  titulo    String?
  subtitulo String?
  url       String?
  imagemUrl String?
  imagemTamanho Int? // largura em % da coluna; vazio = 100
  imagemLargura Int? // tamanho real do arquivo, como Pagina.avatarLargura
  imagemAltura  Int?
  icone     String? // nome do ícone, quando o tipo usa

  // tipo = whatsapp
  telefone String?
  mensagem String?

  // aparência individual (herda o tema da página quando vazio)
  corFundo String?
  corTexto String?
  destaque Boolean @default(false)
  largura  String? // fração da linha: 3/4 | 2/3 | 1/2 | 1/3 | 1/4; vazio = inteira (lib/tema.ts)

  // Layout por tela, como na Pagina: imagemTamanho, iconeTamanho, iconeEspaco e largura
  // são do celular; tablet e computador guardam só o que mudou, em JSON.
  ajustesTablet     String?
  ajustesComputador String?

  ordem Int     @default(0)
  ativo Boolean @default(true)

  // agendamento: fora da janela, o card não aparece
  publicarEm    DateTime?
  despublicarEm DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  cliques Clique[]
  programados LinkProgramado[] // link, destaque, imagem e vídeo: outro endereço no lugar do url, num período
  icones  Icone[] // tipo = redes
  imagens ImagemCarrossel[] // tipo = carrossel
  unidades Unidade[] // tipo = unidades
  iconeTamanho Int? // tipo = redes: tamanho do ícone em px; vazio = 28
  iconeEspaco  Int? // tipo = redes: espaço entre os ícones em px; vazio = 24
  iconeCor     String? // tipo = redes: vazio = cor do texto · "marcas" · "#RRGGBB" (lib/redes.ts)
  letraTamanho Int? // tipo = titulo ou texto: tamanho da letra em px; vazio = 13 no título, 15 no texto
  fonte        String? // tipo = titulo ou texto: fonte do bloco (lib/fontes.ts); vazio = a da página
  formato      String? // tipo = titulo ou texto: "negrito italico sublinhado riscado" (as marcadas); vazio = o padrão do bloco · tipo = video: "horizontal" ou "vertical"; vazio = o do próprio vídeo (lib/video.ts)
  rico         String? // tipo = titulo ou texto: formatação por trecho (JSON, lib/textoRico.ts); vazio = só o texto puro do titulo
  itens    String? // tipo = lista: os itens, um por linha
  marcador String? // tipo = lista: vazio = bolinha · "check" · "numero" (lib/lista.ts)
  animacao       String? // link, destaque, whatsapp, imagem e redes: "reflexo" · "pulsar" · "tremer" (lib/animacoes.ts); vazio = parado
  colunas        Int? // tipo = unidades: unidades por linha (por tela, lib/ajustes.ts); vazio = 1 no celular, 2 no tablet e no computador
  carrosselTempo Int? // tipo = carrossel: velocidade, segundos para cada imagem passar; vazio = 4
  slideLargura   Int? // tipo = carrossel: largura de cada imagem em % da coluna; vazio = 80 no celular, 60 no tablet e no computador

  @@index([paginaId, ordem])
  @@index([ativo])
}

/// Link programado de um bloco (lib/linksProgramados.ts): de `inicio` até `fim`, o bloco leva
/// para `url` no lugar do endereço de destino (Card.url). Os períodos de um bloco não se
/// sobrepõem, então há no máximo um no ar. Até 10 por bloco; os que acabaram somem do editor.
model LinkProgramado {
  id       String   @id @default(cuid())
  cardId   String
  card     Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  url      String
  inicio   DateTime
  fim      DateTime
  criadoEm DateTime @default(now())

  @@index([cardId, inicio])
}

/// Ícone de um bloco "redes": a rede (whatsapp, instagram…, ver lib/redes.ts) e o
/// link. Vários por bloco, lado a lado, na ordem de `ordem`.
model Icone {
  id     String @id @default(cuid())
  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  rede   String
  url    String
  ordem  Int    @default(0)

  cliques Clique[]

  @@index([cardId, ordem])
}

/// Imagem de um bloco "carrossel": vão passando sozinhas, na ordem de `ordem`, cada
/// uma com link opcional (vazio = só aparece).
model ImagemCarrossel {
  id        String   @id @default(cuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  imagemUrl String
  largura   Int? // tamanho real do arquivo, como Pagina.avatarLargura
  altura    Int?
  url       String?
  ordem     Int      @default(0)
  criadoEm  DateTime @default(now())

  @@index([cardId, ordem])
}

/// Unidade de um bloco "unidades": foto horizontal em cima, nome e endereço embaixo, e o
/// link (na foto e na seta). Para quem tem vários endereços. Cores do cartão: corFundo e
/// corTexto do bloco.
model Unidade {
  id        String   @id @default(cuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  nome      String
  endereco  String?
  url       String?
  imagemUrl String?
  ordem     Int      @default(0)
  criadoEm  DateTime @default(now())

  @@index([cardId, ordem])
}

/// Contagem simples de cliques. Sem cookie, sem rastreio de pessoa.
model Clique {
  id       String   @id @default(cuid())
  cardId   String
  card     Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  iconeId  String? // qual ícone, quando o clique foi num bloco de redes
  icone    Icone?   @relation(fields: [iconeId], references: [id], onDelete: SetNull)
  data     DateTime @default(now())
  origem   String? // referrer, quando houver

  @@index([cardId, data])
  @@index([iconeId])
}

/// Endereço antigo do domínio que leva para outro do mesmo domínio (menu Redirecionamentos
/// do painel, lib/redirecionamentos.ts). Só vale onde não há página no ar: um cliente
/// publicado no mesmo endereço sempre ganha.
model Redirecionamento {
  id   String @id @default(cuid())
  de   String @unique // o endereço antigo, sem barras nas pontas e em minúsculas: "fulano" ou "fulano/links"
  para String // para onde leva, no mesmo domínio, como vai no Location: "/novo/" ou "/novo/?utm_source=bio"

  acessos        Int       @default(0) // quantas vezes alguém passou por ele (fora quem está logado no painel)
  ultimoAcessoEm DateTime?
  criadoEm       DateTime  @default(now())
}

/// Quem entra no painel.
/// papel = admin (equipe Dunamis, vê tudo) | cliente (vê só a própria conta)
/// O papel cliente já existe no modelo, mas o login dele só é liberado quando o
/// Bruno decidir — hoje apenas admin usa o painel.
model Usuario {
  id        String  @id @default(cuid())
  email     String  @unique
  nome      String?
  senhaHash String?
  papel     String  @default("admin")
  ativo     Boolean @default(true)

  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  criadoEm      DateTime  @default(now())
  ultimoAcessoEm DateTime?

  @@index([papel])
}
